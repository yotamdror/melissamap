# ── Google Maps ──────────────────────────────────────────────────────────────
# Used by the sync script (server-side) for Places API calls.
# Restrict to Places API in Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# Exposed to the frontend for rendering the map.
# Restrict to Maps JavaScript API + your domain in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# The Map ID created in Google Cloud Console (required for AdvancedMarkers).
VITE_GOOGLE_MAPS_MAP_ID=

# ── Google Sheets ─────────────────────────────────────────────────────────────
GOOGLE_SHEET_ID=your-google-sheet-id

# Service account credentials — paste the entire JSON key as a single line.
# Share your sheet with the service account email as an Editor (the app writes
# new/edited rows back to the sheet, not just reads it).
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── App auth ──────────────────────────────────────────────────────────────────
# Two-tier access: admins can add/edit places, viewers can only browse.
VIEWER_PASSWORD=
ADMIN_PASSWORD=
# Generate with: openssl rand -base64 32
JWT_SECRET=
