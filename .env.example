# ── Google Maps ──────────────────────────────────────────────────────────────
# Used by the sync script (server-side) for Places API calls.
# Restrict to Places API in Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# Exposed to the frontend for rendering the map.
# Restrict to Maps JavaScript API + your domain in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# The Map ID created in Google Cloud Console (required for AdvancedMarkers).
VITE_GOOGLE_MAPS_MAP_ID=

# ── Google Sheets ─────────────────────────────────────────────────────────────
GOOGLE_SHEET_ID=1sQryDBAR_7NfmL5vTSxKPy73SyWGK1cyDhWYn5OvRAY

# Service account credentials — paste the entire JSON key as a single line.
# Share your sheet with the service account email (view access only).
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── App auth ──────────────────────────────────────────────────────────────────
APP_PASSWORD=
# Generate with: openssl rand -base64 32
JWT_SECRET=
